---
layout: layouts/default.njk
---

{%- from 'macro.btn.njk' import btn -%}

<figure class="flex-(& col) items-center gap-6 relative md:(flex-row-reverse items-start gap-12)">
  <img src="/_assets/img/goblin-{{ title | slugify }}.jpg" alt="{{ title }} photo" class="p-px border-(& black) w-full max-w-xs bg-gradient-to-br from-sec-200 to-sec-700 shrink-0 rounded-xl shadow-2xl" />
  <figcaption class="prose max-w-[80ch] grow md:text-lg">
    {{ desc | md | safe }}
    {%- if gear %}
    <div class="not-prose">
      <ul class="my-2 flex-(& wrap) gap-6 [&_a]:(m-0 p-2 text-current bg-(pri-500/20 gradient-to-b) from-white/20 inline-flex rounded-lg shadow-[inset_0_1px_2px_rgba(255,255,255,.25),inset_0_0_0_1px_rgba(255,255,255,.05),0_2px_6px_rgba(0,0,0,.75)] transition hover:(text-pri-50 bg-pri-500/40))">
        {%- for item, props in gear %}
          <li>
            <a href="{{ props.url }}" aria-label="{{ item }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="280" height="100" role="img" class="w-28 h-auto fill-current">
                <use href="/_assets/logos.svg?bust={% bust %}#logo-{{ item | slugify }}" />
              </svg>
            </a>
          </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    <span class="text-sec-300 block absolute -top-2.5 right-1/2 translate-x-1/2 animate-ping md:(-right-2.5 translate-x-0)" aria-hidden="true"><iconify-icon icon="mdi:sparkles" width="24px" height="24px" class="iconify" noobserver></iconify-icon></span>
  </figcaption>
</figure>
<nav class="pt-6 flex items-center justify-center gap-1 md:gap-4">
  {{ btn({
    title: 'Back',
    ico: 'mdi:arrow-left',
    url: '/'
  }) }}
  <ul class="flex items-center gap-1 md:gap-4">
    {%- for goblin in collections.goblins %}
    <li>
      <a href="{{ goblin.url }}" class="block ring-1 {{ 'ring-sec-300/100 opacity-100 pointer-events-none' if goblin.url === page.url else 'ring-white/0 opacity-50' }} rounded-full transition hover:(ring-white/100 opacity-100)" aria-label="{{ goblin.data.title }}" x-tooltip="'{{ goblin.data.title }}'">
        <img class="w-11 h-11 block object-cover object-top rounded-full" src="/_assets/img/goblin-{{ goblin.data.title | slugify }}.jpg" width="44" height="44" alt="{{ goblin.data.title }} photo" />
      </a>
    </li>
    {%- endfor %}
  </ul>
</nav>
<p class="pt-6 text-center">

</p>
