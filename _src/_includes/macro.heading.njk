{%- macro heading(param) -%}
  {%- set tag -%}{{ param.tag if param.tag else 'h1' }}{%- endset -%}
  <{{ tag }} class="
    bg-[length:200%_auto]
    bg-(clip-text [linear-gradient(to_bottom,theme(colors.pri.200),theme(colors.pri.500),theme(colors.lime.500),theme(colors.pri.200))])
    text-(transparent 5xl center)
    font-goblin
    md:(text-[8rem] tracking-tight)
    motion-safe:(animate-header)
  ">
    <span class="[text-shadow:0_5px_25px_color-mix(in_oklab,theme(colors.sec.500),transparent_65%)]">
      <span class="flex items-center justify-center gap-3 md:gap-5">
        {%- if param.title === 'Goblin Gang' %}
          Goblin <img src="{{ '/' | url }}_assets/img/jewel.png" alt="jewel" class="w-6 h-auto md:w-auto" /> Gang
        {%- else %}
          {{ param.title }}
        {%- endif %}
      </span>
      <small class="text-(sec-500 xl) tracking-normal block md:(text-3xl)">{{ param.subtitle }}</small>
    </span>
  </{{ tag }}>
{%- endmacro -%}
